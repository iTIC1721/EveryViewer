<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Exported so the app under test can read it, as it would another app's shared file. -->
        <provider
            android:name="com.tabpdf.tabs.TestPdfProvider"
            android:authorities="com.tabpdf.test.pdfs"
            android:exported="true" />
        <!-- Gives other bytes each time a file is read, as a hostile app's provider could (SecurityTest). -->
        <provider
            android:name="com.tabpdf.doc.ChangingImageProvider"
            android:authorities="com.tabpdf.test.images"
            android:exported="true" />
    </application>

</manifest>
