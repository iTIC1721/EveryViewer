# Release signing (app/build.gradle.kts). Copy to keystore.properties (never committed) and fill in.
# The key itself stays outside the repository; keep a backup of it and its password:
# updates must be signed with the same key, or users have to reinstall and lose their tabs and ink.
storeFile=C:/Users/user/keys/everyviewer.jks
storePassword=
keyAlias=everyviewer
keyPassword=
